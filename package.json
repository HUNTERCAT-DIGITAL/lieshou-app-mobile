  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@lieshoucloud/contract-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "~22.9.0",
    "@types/react": "~19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
