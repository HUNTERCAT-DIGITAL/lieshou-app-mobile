{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@lieshoucloud/contract-api": [
        "./open/contract-api/src"
      ],
      "@lieshoucloud/contract-types": [
        "./open/contract-types/src"
      ],
      "@lieshoucloud/haizan": [
        "../packages/haizan/src"
      ],
      "@lieshoucloud/haizan/*": [
        "../packages/haizan/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "open/*/src/**/*.test.*",
    "industry",
    "open",
    "open/**"
  ]
}
