{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@lieshoucloud/api-client": ["./open/packages/api-client/src"],
      "@lieshoucloud/types": ["./open/packages/types/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
