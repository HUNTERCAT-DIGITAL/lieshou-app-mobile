{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@lieshoucloud/contract-api": [
        "./open/contract-api/src"
      ],
      "@lieshoucloud/contract-config": [
        "./open/contract-config/src"
      ],
      "@lieshoucloud/contract-types": [
        "./open/contract-types/src"
      ],
      "@lieshoucloud/contract-types/*": [
        "./open/contract-types/src/*"
      ],
      "@lieshoucloud/core-web": [
        "./open/core-web/src"
      ],
      "@lieshoucloud/i18n": [
        "./open/i18n/src"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "open",
    "open/**"
  ]
}
